<Window x:Class="HamTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HamTool | OSINT Research Workspace" Height="820" Width="1320" MinHeight="700" MinWidth="1050" Background="#F5F7FB" Foreground="#172033" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,18,0"><DockPanel><StackPanel DockPanel.Dock="Top"><Border Background="#EEF2FF" CornerRadius="10" Padding="12" Margin="2,4,2,22"><StackPanel><TextBlock Text="HAMTOOL" FontSize="24" FontWeight="Bold" Foreground="#2446B5"/><TextBlock Text="RESEARCH WORKSPACE" FontSize="10" Foreground="#667085" Margin="0,2,0,0"/></StackPanel></Border><Button Content="▦   Overview" Click="Overview_Click" HorizontalContentAlignment="Left"/><Button Content="⌕   New research" Click="Research_Click" HorizontalContentAlignment="Left"/><Button Content="▤   Research log" Click="Log_Click" HorizontalContentAlignment="Left"/><Button Content="◫   Cases &amp; notes" Click="Cases_Click" HorizontalContentAlignment="Left"/><Button Content="⚙   Preferences" Click="Preferences_Click" HorizontalContentAlignment="Left"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,2"><TextBlock Text="LOCAL-FIRST MODE" FontSize="10" FontWeight="Bold" Foreground="#667085"/><TextBlock Text="Data stored on this PC" FontSize="11" Foreground="#98A2B3" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="A clean workspace for public-source research." Foreground="#667085" FontSize="14" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1">
<Grid x:Name="OverviewPage"><StackPanel><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Research with structure." FontSize="24" FontWeight="Bold"/><TextBlock Text="Build public search links, keep a local audit trail, organize notes by case, and export your work." TextWrapping="Wrap" Foreground="#667085" FontSize="14" Margin="0,9,20,16"/><Button Content="＋  Start new research" HorizontalAlignment="Left" Background="#2457E6" Foreground="White" BorderBrush="#2457E6" Click="Research_Click"/></StackPanel><Border Grid.Column="1" Background="#EEF2FF" CornerRadius="14" Padding="18" VerticalAlignment="Stretch"><StackPanel VerticalAlignment="Center"><TextBlock Text="LOCAL-FIRST" Foreground="#2446B5" FontWeight="Bold"/><TextBlock Text="Your research log stays on this computer." Foreground="#475467" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid></Border><UniformGrid Columns="3" Margin="0,0,0,16"><Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="LOG ENTRIES" Foreground="#667085" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="RecordCount" Text="0" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Saved research queries" Foreground="#667085" FontSize="12"/></StackPanel></Border><Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="SOURCE MODULES" Foreground="#667085" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="SearchDestinationCount" Text="190" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="SearchDestinationDetails" Text="Grouped into 13 categories" Foreground="#667085" FontSize="12"/></StackPanel></Border><Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="EXPORT FORMATS" Foreground="#667085" FontSize="11" FontWeight="Bold"/><TextBlock Text="3" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="JSON · CSV · TOML" Foreground="#667085" FontSize="12"/></StackPanel></Border></UniformGrid><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Responsible research" FontSize="17" FontWeight="Bold"/><TextBlock Text="HamTool prepares links to public resources and organizes your own notes. It does not bypass access controls, scrape private accounts, or verify the truth of search results. Respect privacy and applicable law." TextWrapping="Wrap" Foreground="#667085" Margin="0,7,0,0"/></StackPanel></Border></StackPanel></Grid>
<Grid x:Name="ResearchPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Research parameters" FontSize="18" FontWeight="Bold"/><TextBlock Text="Case / project" Foreground="#667085" Margin="4,16,4,0"/><TextBox x:Name="CaseInput" Text="General"/><TextBlock Text="Query category" Foreground="#667085" Margin="4,8,4,0"/><ComboBox x:Name="QueryType" SelectedIndex="0"><ComboBoxItem Content="Keywords" Tag="Keywords"/><ComboBoxItem Content="Username / handle" Tag="Username / handle"/><ComboBoxItem Content="Domain / website" Tag="Domain / website"/><ComboBoxItem Content="Public organization" Tag="Public organization"/><ComboBoxItem Content="Phone number (public listings)" Tag="Phone number"/><ComboBoxItem Content="IP address / ASN" Tag="IP address"/><ComboBoxItem Content="Email / public contact" Tag="Email address"/><ComboBoxItem Content="Batch website check (up to 5,000 URLs)" Tag="Website batch scan"/></ComboBox><TextBlock Text="Search terms" Foreground="#667085" Margin="4,8,4,0"/><TextBox x:Name="QueryInput" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Research note (optional)" Foreground="#667085" Margin="4,8,4,0"/><TextBox x:Name="NotesInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0"><Button Content="Run live search" Background="#2457E6" Foreground="White" BorderBrush="#2457E6" Click="LiveSearch_Click"/><Button Content="Generate links" Click="Generate_Click"/><Button Content="Clear form" Click="ClearForm_Click"/><Button Content="Cancel scan" Click="CancelSearch_Click"/></WrapPanel><TextBlock Text="Tip: use a specific public organization or domain. For batch website check, paste one public URL per line (up to 5,000). It checks availability only, not vulnerabilities. Do not enter passwords, private records, or sensitive personal data." Foreground="#667085" TextWrapping="Wrap" Margin="4,12,4,0"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1"><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Search results" FontSize="18" FontWeight="Bold"/><TextBlock Text="Live search calls public APIs. Double-click an item to open its source." Foreground="#667085" Margin="0,4,0,8"/><TextBlock Text="Source category filter" Foreground="#667085" Margin="0,4,0,3"/><ComboBox x:Name="SourceCategoryFilter" SelectionChanged="SourceCategoryFilter_SelectionChanged" Margin="0,0,0,8"/><TabControl MinHeight="380" Height="420" VerticalAlignment="Top"><TabItem Header="Live results"><DockPanel Margin="6"><TextBlock x:Name="ProviderStatusText" DockPanel.Dock="Bottom" Text="Ready to query public APIs." Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,0"/><ListBox x:Name="LiveResultsList" Background="#FFFFFF" BorderBrush="#E4E7EC" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollableList_PreviewMouseWheel" MouseDoubleClick="LiveResults_DoubleClick"/></DockPanel></TabItem><TabItem Header="Search links"><ListBox x:Name="LinksList" Background="#FFFFFF" BorderBrush="#E4E7EC" Margin="6" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollableList_PreviewMouseWheel" MouseDoubleClick="LinksList_DoubleClick"/></TabItem></TabControl><WrapPanel Margin="0,8,0,0"><Button Content="Export live results…" Click="ExportLiveResults_Click"/><TextBlock Text="Provider APIs can rate-limit or return no matches; verify findings at the source." Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,4,0,0"/></WrapPanel></StackPanel></Border></StackPanel></Grid>
<Grid x:Name="LogPage" Visibility="Collapsed"><DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBox x:Name="LogFilter" Width="300" ToolTip="Filter by case, query, or note"/><Button Content="Filter" Click="FilterLog_Click"/><Button Content="Refresh" Click="RefreshLog_Click"/><Button Content="Export…" Click="Export_Click"/><Button Content="Delete selected" Click="DeleteSelected_Click"/><Button Content="Clear all" Click="ClearAll_Click"/></WrapPanel><TextBlock Text="Stored locally in SQLite. Select a row to delete one entry." Foreground="#667085" Margin="5,3,0,10"/></StackPanel><DataGrid x:Name="LogGrid" AlternationCount="2" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGeneratingColumn="LogGrid_AutoGeneratingColumn"/></DockPanel></Grid>
<Grid x:Name="CasesPage" Visibility="Collapsed"><StackPanel><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Case overview" FontSize="20" FontWeight="Bold"/><TextBlock Text="Cases are represented by the Case / project field on each research entry. Use consistent names to group work; filter the research log to review a case." TextWrapping="Wrap" Foreground="#667085" Margin="0,7,0,10"/><Button Content="Open research log" HorizontalAlignment="Left" Click="Log_Click"/></StackPanel></Border><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Note-taking guidance" FontSize="17" FontWeight="Bold"/><TextBlock Text="Record source URLs and dates in your notes. Separate observed facts from hypotheses, and retain only information needed for a legitimate purpose." Foreground="#667085" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel></Grid>
<Grid x:Name="PreferencesPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Appearance" FontSize="18" FontWeight="Bold"/><TextBlock Text="Language" Foreground="#667085" Margin="4,12,4,0"/><ComboBox x:Name="LanguageChoice" SelectedIndex="0" SelectionChanged="LanguageChoice_SelectionChanged"><ComboBoxItem Content="Українська" Tag="uk"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Polski" Tag="pl"/><ComboBoxItem Content="Deutsch" Tag="de"/><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox><TextBlock Text="The selected language applies to the entire interface and is saved." Foreground="#667085" Margin="4,4,4,0"/><TextBlock Text="Theme" Foreground="#667085" Margin="4,12,4,0"/><ComboBox x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="ThemeChoice_SelectionChanged"><ComboBoxItem Content="Light — soft gray-blue background"/><ComboBoxItem Content="White — pure white background"/></ComboBox><TextBlock Text="Light theme uses a soft background; white theme makes the main background pure white. Your choice is saved." Foreground="#667085" Margin="4,4,4,0"/></StackPanel></Border><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Research &amp; privacy" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="SaveHistoryCheck" Content="Save queries to local research history"/><CheckBox x:Name="ConfirmClearCheck" Content="Ask for confirmation before clearing history"/><CheckBox x:Name="OpenBrowserCheck" Content="Allow opening selected public links in the browser"/><CheckBox x:Name="TimestampCheck" Content="Include timestamps in exports"/><TextBlock Text="Local data folder" Foreground="#667085" Margin="4,12,4,0"/><TextBlock x:Name="DataFolderText" TextWrapping="Wrap" Margin="4,4,4,8"/><Button Content="Open data folder" HorizontalAlignment="Left" Click="OpenDataFolder_Click"/></StackPanel></Border><Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Export defaults" FontSize="18" FontWeight="Bold"/><TextBlock Text="Default export format" Foreground="#667085" Margin="4,12,4,0"/><ComboBox x:Name="ExportFormat" SelectedIndex="0"><ComboBoxItem Content="JSON"/><ComboBoxItem Content="CSV"/><ComboBoxItem Content="TOML"/></ComboBox><TextBlock Text="Limits" Foreground="#667085" Margin="4,12,4,0"/><TextBlock Text="History view is limited to the latest 5,000 records for responsiveness." Foreground="#667085" Margin="4,4,4,8"/><Button Content="Save preferences" Background="#2457E6" Foreground="White" BorderBrush="#2457E6" HorizontalAlignment="Left" Click="SavePreferences_Click"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>
</Grid><TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready." Foreground="#667085" Margin="4,12,0,0"/></Grid></Grid></Window>

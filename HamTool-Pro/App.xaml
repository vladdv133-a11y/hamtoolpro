<Application x:Class="HamTool.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Ink" Color="#172033"/><SolidColorBrush x:Key="Muted" Color="#667085"/><SolidColorBrush x:Key="Line" Color="#E4E7EC"/><SolidColorBrush x:Key="Canvas" Color="#F5F7FB"/><SolidColorBrush x:Key="Panel" Color="#FFFFFF"/><SolidColorBrush x:Key="Blue" Color="#2457E6"/>
 <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#344054"/><Setter Property="Margin" Value="5"/></Style>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAECF0"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/></Style>
</Application.Resources></Application>
